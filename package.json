{
  "name": "crt-tv-tuner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "validate:assets": "node scripts/validate-signals.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "check": "npm run lint && npm run typecheck && npm run validate:assets",
    "prebuild": "npm run check",
    "postbuild": "npm run validate:build",
    "release": "npm run check && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "playwright": "^1.61.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
